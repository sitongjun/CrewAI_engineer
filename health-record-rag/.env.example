# Agent 使用的聊天模型。DeepSeek 示例：
CHAT_MODEL=deepseek/deepseek-chat
CHAT_API_BASE=https://api.deepseek.com
CHAT_API_KEY=请填写聊天模型API_KEY
CHAT_TEMPERATURE=0.2
CHAT_TIMEOUT_SECONDS=90
CHAT_MAX_RETRIES=1

# PDFSearchTool 使用的 Embedding 模型，必须支持 /embeddings 接口。
# DeepSeek 聊天 Key 不能代替 Embedding Key。
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=请填写Embedding模型API_KEY

PORT=8012
